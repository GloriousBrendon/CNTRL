# CNTRL — restore saved per-device RGB on login (systemd USER service).
#
# Installed by `INSTALL_SYSTEMD=1 ./scripts/install.sh`, which also points
# ExecStart at the install prefix.
#
# Runs as your user (so it has your hidraw/i2c group access) shortly after the
# session starts, re-applying each device's last color/effect via `cntrl restore`.

[Unit]
Description=CNTRL restore saved RGB lighting
After=graphical-session.target

[Service]
Type=oneshot
# Give udev a moment to create the hidraw/i2c nodes after login.
ExecStartPre=/usr/bin/sleep 3
ExecStart=/usr/local/bin/cntrl restore

[Install]
WantedBy=default.target
