[Unit]
Description=CNTRL RGB Probe (persist OpenRGB mapping at boot)
Documentation=https://github.com/USER/CNTRL
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
User=USER
Environment=HOME=/home/USER
# Adjust this path if cntrl is not installed system-wide.
ExecStart=/usr/local/bin/cntrl probe-rgb --force --no-apply

[Install]
WantedBy=multi-user.target
