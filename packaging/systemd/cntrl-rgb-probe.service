[Unit]
Description=CNTRL RGB probe (record detected RGB devices at boot)
Documentation=https://github.com/GloriousBrendon/CNTRL
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
# scripts/install.sh fills in the installing user and the binary path.
User=@USER@
Environment=HOME=@HOME@
ExecStart=/usr/local/bin/cntrl probe-rgb --force --no-apply

[Install]
WantedBy=multi-user.target
